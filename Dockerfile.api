FROM python:3.12-slim

WORKDIR /app

# Install UV
RUN pip install uv

# Copy dependency files
COPY pyproject.toml . 
COPY uv.lock .

# Install dependencies with UV
RUN uv sync --frozen

# Copy application files
COPY api/ ./api/

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]