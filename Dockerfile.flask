FROM python:3.12-slim

WORKDIR /app

# Install UV
RUN pip install uv

# Copy dependency files
COPY pyproject.toml . 
COPY uv.lock .

# Install dependencies with UV
RUN uv sync --frozen

# Copy application files
COPY app.py . 
COPY templates/ ./templates/
COPY static/ ./static/

RUN mkdir -p static/uploads

EXPOSE 8080

CMD ["uv", "run", "python", "app.py"]